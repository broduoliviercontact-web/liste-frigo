{
  "name": "liste-frigo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "dev:local": "npm run db:migrate:local && npm run dev",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/boats.test.ts tests/validation.test.ts tests/client-mutation-queue.test.ts tests/pending-list-mutations.test.ts tests/transit.test.mjs tests/source-policy.test.mjs",
    "test:transit": "node --test tests/transit.test.mjs",
    "test:idempotency": "node --test tests/idempotency.integration.mjs",
    "test:browser:lost-response": "node tests/lost-response.browser.mjs",
    "test:browser:reauth": "node tests/reauth.browser.mjs",
    "test:browser:rejected": "node tests/rejected.browser.mjs",
    "test:browser:rate-limit-seconds": "node tests/rate-limit-seconds.browser.mjs",
    "test:browser:rate-limit-additional": "node tests/rate-limit-additional.browser.mjs",
    "test:browser:multi-tab": "node tests/multi-tab.browser.mjs",
    "test:browser:journal-limits": "node tests/journal-limits.browser.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply site-creator-d1 --local --config wrangler.local.jsonc",
    "test:reliability": "node --test tests/reliability.integration.mjs",
    "test:browser:settings-keyboard": "node --test tests/settings-keyboard.browser.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satellite.js": "^7.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.116.0"
  },
  "type": "module",
  "displayName": "SUPERVIE"
}
